# ============================================================
# Procogia BD Agent — Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to git.
# ============================================================

# ------------------------------------------------------------
# AI / LLM
# ------------------------------------------------------------
ANTHROPIC_API_KEY=                  # Required — Claude API (Haiku + Sonnet)

# ------------------------------------------------------------
# Email delivery (Resend)
# ------------------------------------------------------------
RESEND_API_KEY=                     # Required — Resend API key
DIGEST_SENDER=                      # Required — From address, e.g. noreply@yourdomain.com
DIGEST_RECIPIENT=                   # Required — To address for weekly digest

# ------------------------------------------------------------
# Contact discovery
# ------------------------------------------------------------
HUNTER_API_KEY=                     # Required — Hunter.io domain email search
SERPAPI_KEY=                        # Required — SerpAPI (org website + LinkedIn discovery)

# ------------------------------------------------------------
# Authenticated scrapers (optional — scrapers degrade gracefully if missing)
# ------------------------------------------------------------
BIDS_AND_TENDERS_LOGIN=             # Metro Vancouver portal login email
BIDS_AND_TENDERS_PASSWORD=          # Metro Vancouver portal password

BIDSCANADA_LOGIN=                   # BidsCanada login email
BIDSCANADA_PASSWORD=                # BidsCanada password

TorontoBidsPortal_LOGIN=            # Toronto Bids Portal login (if auth required)
TorontoBidsPortal_PASSWORD=         # Toronto Bids Portal password

BCBid_LOGIN=                        # BCBid login username
BCBid_PASSWORD=                     # BCBid password

MetroVancouver_LOGIN=               # Metro Vancouver login email
MetroVancouver_PASSWORD=            # Metro Vancouver password

# ------------------------------------------------------------
# Client identity — injected into AI system prompts and digest headers
# ------------------------------------------------------------
CLIENT_NAME=Your Organization                           # Organization name
CLIENT_DESCRIPTION=a data and analytics consultancy     # One-line descriptor for AI prompts

# ------------------------------------------------------------
# Pipeline tuning (defaults shown — override only if needed)
# ------------------------------------------------------------
FILTER_THRESHOLD=60                 # Haiku pre-filter cutoff (0–100); listings below are dropped
CONTACT_THRESHOLD=70                # Minimum contact relevance score to retain
PURSUE_THRESHOLD=75                 # Minimum relevance_score to recommend PURSUE
AGENT_TIMEOUT_SECONDS=30            # Per-agent signal.alarm timeout
DRY_RUN=false                       # true = fixture data, no API calls, no email sent
DB_PATH=data/opportunities.db       # SQLite database path
CALIBRATION_PATH=tests/fixtures/calibration_set.json  # Golden scoring set for drift detection

# ------------------------------------------------------------
# GitHub (local dev only — not needed in GitHub Actions)
# ------------------------------------------------------------
# GitHub_PAT_Token=                 # PAT for git push via HTTPS (stored in macOS Keychain)

# ------------------------------------------------------------
# Deprecated — do not use
# ------------------------------------------------------------
# SENDGRID_API_KEY=                 # Migrated to Resend on 2026-03-02; remove if present
